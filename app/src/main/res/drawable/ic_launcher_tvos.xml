<?xml version="1.0" encoding="utf-8"?>
<!-- API 19 safe: layer-list + shape drawables (no vector support on KitKat) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- dark rounded TV body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1C1E" />
            <corners android:radius="8px" />
            <stroke android:width="1px" android:color="#80FFFFFF" />
        </shape>
    </item>

    <!-- blue screen -->
    <item android:left="10px" android:right="10px" android:top="10px" android:bottom="20px">
        <shape android:shape="rectangle">
            <solid android:color="#007AFF" />
            <corners android:radius="3px" />
        </shape>
    </item>

    <!-- saffron bar -->
    <item android:left="10px" android:right="10px" android:top="34px" android:bottom="16px">
        <shape android:shape="rectangle">
            <solid android:color="#FF9933" />
        </shape>
    </item>

    <!-- green bar -->
    <item android:left="10px" android:right="10px" android:top="38px" android:bottom="12px">
        <shape android:shape="rectangle">
            <solid android:color="#138808" />
        </shape>
    </item>
</layer-list>
